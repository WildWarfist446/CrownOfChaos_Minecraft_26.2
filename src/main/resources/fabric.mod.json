{
	"schemaVersion": 1,
	"id": "crownofchaos",
	"version": "${version}",
	"name": "The Crown of Chaos",
	"description": "A Fabric mod for Minecraft 26.2.",
	"authors": [
		"Warfist"
	],
	"license": "CC0-1.0",
	"icon": "assets/crownofchaos/icon.png",
	"environment": "*",
	"entrypoints": {
